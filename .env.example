# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# ---------------------------------------------------------------------------
# Smart plug (Tapo P110M / KLAP). Read by the main process at runtime.
# ---------------------------------------------------------------------------
FOCUSPLUG_TAPO_USERNAME=
FOCUSPLUG_TAPO_PASSWORD=

# ---------------------------------------------------------------------------
# Adaption Labs — Adaptive Data.  https://docs.adaptionlabs.ai
#
# THE APP NEVER READS THIS. FocusPlug makes no network calls for the adaptive
# fuse: it learns on-device from drifts it already observes, and that is the
# whole privacy claim. This key is for the offline dataset workflow only — you
# run it yourself, from a terminal, on an exported file:
#
#   npm run dataset:adapt                     # write datasets/focusplug-drifts.csv
#   pip install adaption
#   python scripts/adaption-upload.py         # shape it
#   npm run prior:adapt -- <file that came back>
#
# If you ever find this variable referenced from src/main or src/renderer,
# that is a bug and it breaks the product's promise.
# ---------------------------------------------------------------------------
ADAPTION_API_KEY=
