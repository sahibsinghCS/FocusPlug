{
  "name": "focusplug",
  "version": "0.1.0",
  "private": true,
  "description": "Local study-session enforcer: detect leave-assignment, force-quit Discord/games, unlock only when back on task.",
  "author": "FocusPlug",
  "license": "MIT",
  "homepage": "https://github.com/sahibsinghCS/FocusPlug",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:session": "vitest run src/main/session",
    "test:plugs": "vitest run src/main/plugs",
    "gauntlet:plugs": "tsx --tsconfig tsconfig.node.json src/main/plugs/gauntlet.ts",
    "probe:plugs": "tsx --tsconfig tsconfig.node.json src/main/plugs/probe.ts",
    "typecheck": "npm run check:contracts && npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "check:contracts": "node scripts/check-contracts.mjs",
    "test:window": "node --experimental-strip-types --test src/main/window/match.test.ts src/main/window/monitor.test.ts src/main/store/lists.test.ts",
    "probe:window": "node --experimental-strip-types src/main/window/probe.ts",
    "test:desk": "tsx --tsconfig tsconfig.node.json src/main/desk/gauntlet.ts",
    "faces:preview": "vite --config scripts/faces-preview.vite.ts",
    "faces:stills": "node scripts/faces-stills.mjs",
    "test:flight": "vitest run src/renderer/src/features/faces/flight",
    "gauntlet:flight": "node scripts/flight-stills.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.19.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.0"
  }
}
